{
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(git for-each-ref *)",
      "Bash(git merge-base *)",
      "Bash(node --check *)",
      "Bash(node docs/doc-sync.js)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(file *)",
      "Bash(awk *)",
      "Bash(head *)",
      "Bash(sort *)",
      "Bash(comm *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node .claude/hooks/post-edit.js" }
        ]
      }
    ]
  }
}
